########################################
# 🧠 OpenAI Configuration (Required for all environments)
########################################
OPENAI_API_KEY=sk-...                     # 🔐 Required secret key for OpenAI API access
OPENAI_BASE_URL=https://api.openai.com/v1 # ✅ Default base URL—usually unchanged
OPENAI_API_CHAT_TIMEOUT=59000             # ⏱️ Timeout for chat requests (ms)
OPENAI_API_CHAT_RESPONSE_PING_INTERVAL=890 # ⏱️ Interval for pinging streamed responses (ms)
OPENAI_JWT_SECRETS={}                     # 🔐 Object of JWT secrets shared with external AIs—must be valid JSON
OPENAI_Q_GITHUB=https://github.com/MyLife-Services/dandelion # 📎 Reference link to source repo (non-secret)
OPENAI_Q_GPT_OVERRIDE=asst_...            # 🧪 Optional: override model ID for local dev testing
OPENAI_MODEL_CORE_AVATAR=gpt-4o-mini      # ✅ Default model for avatar interactions
OPENAI_MODEL_CORE_BOT=gpt-4o-mini         # ✅ Default model for bot responses
OPENAI_ORG_KEY=org-dTYDMEBuP2yb2qtwCQJA4HHh # 🔐 OpenAI organization ID—used for billing/auth
########################################
# 🌱 Dandelion App Settings
########################################
DANDELION_ALLOW_INTELLIGENT_QUESTIONS=false # 🧪 Feature flag—deprecated, leave false
DANDELION_DB_ALLOW_SAVE=false               # 🧪 Prevents DB writes during local testing
DANDELION_DB_ENDPOINT=https://mylife.documents.azure.com:443/ # ✅ Cosmos DB endpoint
DANDELION_DB_NAME=membership                # ✅ Logical DB name
DANDELION_DB_CONTAINER_NAME=members         # ✅ Primary container name
DANDELION_DB_RW=string                      # 🔐 Read/write DB key—required for full access
DANDELION_DB_RX=string                      # 🔐 Read-only DB key—used for safe queries
DANDELION_SERVER_MBR_ID=mylife|...          # 🔐 Server identity—used for scoped access
DANDELION_HOSTING_KEY=uuid                  # 🔐 Unique hosting key—used for tenant validation
DANDELION_HOSTED_MBR_ID=[]                  # 🧪 Optional: array of hosted member IDs or leave empty
DANDELION_ORIGIN=https://<your-origin-url>  # 🌐 Required for CORS and session validation
DANDELION_REGISTRATION_DB_CONTAINER_NAME=   # 📥 Required if registration is enabled—ask admin
DANDELION_SESSION_KEY=0.0.37                # 🔐 Session reset token—rotate to invalidate sessions
DANDELION_SESSION_TIMEOUT_MS=900000         # ⏱️ Session expiration in milliseconds
DANDELION_SHARES_DB_CONTAINER_NAME=         # 📥 Required if share tracking is enabled—ask admin
DANDELION_SYSTEM_ALERT_CHECK_INTERVAL=120000 # ⏱️ Polling interval for system alerts (ms)
DANDELION_SYSTEM_DB_CONTAINER_NAME=         # 📥 Required for system-level config—ask admin
# PORT is optional—used only in local dev
PORT=3000                                   # 🧪 Local dev port override—ignored in production
########################################
# 📧 Email Credentials
########################################
Q_EMAIL=                                    # 🔐 Email address used for outbound system mail—ask admin
Q_EMAIL_PASSWORD=                           # 🔐 SMTP password or app token—ask admin
########################################
# 🧬 MCP Protocol Settings
########################################
MCP_CLIENT_TOOLS=elicitation, sampling, roots # ✅ Comma-separated list of enabled tools
MCP_JSONRPC_Version=2.0                      # ✅ Protocol version—usually fixed
MCP_JSONRPC_Protocol=2025-03-26              # ✅ Protocol release date—used for compatibility
MCP_PAGE_SIZE=100                            # ✅ Default pagination size for cursor-based queries
MCP_SAMPLING_TOKEN_MAX=1000                  # ✅ Max token count for sampling operations
########################################
# 🔐 NANDA Registry Access
########################################
NANDA_REGISTRY_USER=                         # 🔐 Registry username—ask admin
NANDA_REGISTRY_PASSWORD=                     # 🔐 Registry password or token—ask admin
NANDA_REGISTRY_URL=https://nanda-registry.com/api/v1 # ✅ Base URL for registry API