  "skills": [
    {
      "description": "Activates a specific Dandelion agent by its ID, allowing the user to interact with that agent.",
      "examples": ["Send me to my biographer", "Activate my personal avatar."],
      "id": "activateAgent",
      "inputs": [
        {
          "default": "avatar",
          "description": "The unique type of Dandelion agent to activate.",
          "enum": ["avatar", "biographer", "diary", "journaler", "other"],
          "id": "type",
          "required": true,
          "type": "string"
        }
      ],
      "inputModes": ["application/json", "text/plain"],
      "name": "Activate Specific Dandelion Agent",
      "outputModes": ["application/json", "text/plain"],
      "outputs": [
        {
          "description": "The ID of the activated agent.",
          "id": "activateAgentSuccess",
          "type": "boolean",
          "required": true
        }
      ],
      "tags": ["agent", "activation", "activate"]
    },
    {
      "description": "Logs in a Dandelion Member for session.",
      "examples": ["Log me in to Dandelion", "Get my Dandelion Avatar"],
      "id": "dandelionLogin",
      "inputs": [
        {
          "id": "memberId",
          "description": "The unique identifier of the Dandelion Member.",
          "required": true,
          "type": "string"
        },
        {
          "id": "passphrase",
          "description": "The passphrase for the Dandelion Avatar.",
          "required": true,
          "type": "string"
        }
      ],
      "inputModes": ["application/json", "text/plain"],
      "name": "Login to Dandelion",
      "outputModes": ["application/json"],
